[Unit]
Description=WattWise RPi MQTT Publisher
Documentation=https://github.com/suhas/WattWise
After=network-online.target influxdb.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=pi
Group=pi
ExecStart=/usr/bin/python3 /opt/wattwise/rpi_mqtt_publisher.py --config /etc/wattwise/publisher.yaml
WorkingDirectory=/opt/wattwise
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wattwise-publisher

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
