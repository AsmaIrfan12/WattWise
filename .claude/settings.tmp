{
  "model": "gemma-coder",
  "env": {
    "ANTHROPIC_BASE_URL": "http://localhost:11434",
    "ANTHROPIC_API_KEY": "ollama",
    "ANTHROPIC_AUTH_TOKEN": "ollama"
  },
  "permissions": {
    "allow": [
      "Bash(docker-compose build:*)",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Bash(*)",
      "Grep",
      "Glob",
      "LS",
      "WebFetch",
      "WebSearch",
      "NotebookRead",
      "NotebookEdit",
      "TodoRead",
      "TodoWrite"    ]
  }
}
