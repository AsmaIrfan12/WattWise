# ============================================================
# WattWise — root .env TEMPLATE  (compose variable substitution)
# ============================================================
# Copy to ".env" in the repo root and fill the CHANGE_ME values:
#     cp .env.example .env
# Docker Compose reads this automatically for ${VAR} in docker-compose.yml.
# The backend ALSO needs "Server Side/.env" (see Server Side/.env.production.template).
# Easiest on a new server: scp your working .env files from a machine that works.
#
# ⚠️  Real secrets must NEVER be committed. This file holds placeholders only.

# -- MySQL --
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_DATABASE=wattwise_db
MYSQL_USER=wattwise_app
MYSQL_PASSWORD=CHANGE_ME_app_db_password
DB_USER=wattwise_app
DB_PASS=CHANGE_ME_app_db_password
DB_HOST=mysql
DB_PORT=3306
DB_NAME=wattwise_db

# -- InfluxDB --
INFLUX_HOST=influxdb
INFLUX_PORT=8086
INFLUX_DB=wattwise_energy
INFLUX_USER=wattwise_influx
INFLUX_PASS=CHANGE_ME_influx_password
INFLUX_PROTOCOL=http

# -- MQTT broker --
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=wattwise/homes
MQTT_USERNAME=wattwise_backend
MQTT_PASSWORD=CHANGE_ME_backend_mqtt_password
MQTT_ADMIN_PASS=CHANGE_ME_admin_mqtt_password
# Per-home RPi publisher passwords (username = home_NNN, matches acl.conf).
# Hand the matching one to each participant's rpi_publisher_config.yaml.
MQTT_HOME_001_PASS=CHANGE_ME_home001_password
MQTT_HOME_002_PASS=CHANGE_ME_home002_password
MQTT_HOME_003_PASS=CHANGE_ME_home003_password
MQTT_HOME_004_PASS=CHANGE_ME_home004_password
MQTT_HOME_005_PASS=CHANGE_ME_home005_password
MQTT_HOME_006_PASS=CHANGE_ME_home006_password
MQTT_HOME_007_PASS=CHANGE_ME_home007_password
MQTT_HOME_008_PASS=CHANGE_ME_home008_password
MQTT_HOME_009_PASS=CHANGE_ME_home009_password
MQTT_HOME_010_PASS=CHANGE_ME_home010_password
MQTT_HOME_011_PASS=CHANGE_ME_home011_password
MQTT_HOME_012_PASS=CHANGE_ME_home012_password
MQTT_HOME_013_PASS=CHANGE_ME_home013_password
MQTT_HOME_014_PASS=CHANGE_ME_home014_password
MQTT_HOME_015_PASS=CHANGE_ME_home015_password

# -- Backend API --
SECRET_KEY=CHANGE_ME_long_random_jwt_secret
API_HOST=0.0.0.0
API_PORT=8000
STRICT_SECURITY=true
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
DECISION_MEASURE_WINDOW_HOURS=2

# -- UK energy tariff --
ENERGY_STANDARD_PRICE_PER_KWH=0.2700
ENERGY_PEAK_PRICE_PER_KWH=0.3200
ENERGY_OFFPEAK_PRICE_PER_KWH=0.1300
ENERGY_PEAK_START_HOUR=16
ENERGY_PEAK_END_HOUR=19

# -- Energy alert thresholds --
ENERGY_DAILY_WARNING_KWH=15
ENERGY_DAILY_HIGH_KWH=25
ENERGY_DEVICE_STANDBY_WATTS=5
ENERGY_USAGE_SPIKE_MULTIPLIER=2.0

# -- Push notifications --
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# -- Admin login --
ADMIN_EMAIL=admin@wattwise.co.uk
ADMIN_PASSWORD=CHANGE_ME_admin_portal_password

# -- CORS: add your droplet IP/domain here for the web frontends --
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://YOUR_DROPLET_IP,http://YOUR_DROPLET_IP:3000

# -- Weekly email reports (optional; leave SMTP_USER blank to disable) --
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=WattWise <noreply@wattwiser.org>
