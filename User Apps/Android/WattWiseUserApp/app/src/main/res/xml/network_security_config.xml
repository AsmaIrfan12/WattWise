<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext (HTTP) is allowed to ANY host so that the server address can be
         changed in the app's Settings without rebuilding the APK. The research
         server is a bare-IP DigitalOcean droplet with no TLS. HTTPS hosts still
         work; only system CAs are trusted. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
