<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (HTTP) for the DigitalOcean droplet (bare IP, no TLS yet)
         and local development servers. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">159.65.213.183</domain>  <!-- droplet Reserved IP -->
        <domain includeSubdomains="false">144.126.193.109</domain> <!-- droplet public IP -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>

    <!-- Enforce HTTPS for production server -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">talk2futurebuildings.systems</domain>
    </domain-config>

    <!-- Block cleartext for all other hosts by default -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
