<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (HTTP) only for local development servers. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>

    <!-- Production server (Cloudflare Tunnel, HTTPS only).
         Replace wattwise.example.com with the real domain. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">wattwise.example.com</domain>
    </domain-config>

    <!-- Block cleartext for all other hosts by default -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
