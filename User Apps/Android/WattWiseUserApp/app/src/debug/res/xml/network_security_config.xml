<?xml version="1.0" encoding="utf-8"?>
<!--
    DEBUG ONLY — overrides the main network_security_config.xml for debug builds.
    Allows plain HTTP to any host so you can point the app at a local dev server
    (e.g. http://192.168.x.x:8000 or http://129.x.x.x).
    This file is NOT included in release APKs.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
