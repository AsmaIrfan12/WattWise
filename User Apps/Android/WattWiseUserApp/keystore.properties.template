# Release signing for the WattWise Android app.
# Copy to `keystore.properties` (same directory) and fill in real values.
# keystore.properties is gitignored — never commit the real file or the .jks.
#
# Generate a keystore once:
#   keytool -genkeypair -v -keystore wattwise-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias wattwise
#
# Without keystore.properties the release build falls back to the debug
# signing key (installable APK, but NOT valid for a Play Store upload).

storeFile=wattwise-release.jks
storePassword=CHANGE_ME
keyAlias=wattwise
keyPassword=CHANGE_ME
